# Copy to `.env` and fill in only what you need. Every key is optional:
# with none set, the assistant runs locally with the offline backends.

# --- Cloud backends ---
# With "auto", Gemini is used first, then OpenAI.
# GOOGLE_API_KEY=...          # https://aistudio.google.com/app/apikey
# OPENAI_API_KEY=sk-...

# --- Backend selection ---
# llm provider:        auto | gemini | openai | huggingface | extractive
# embeddings provider: auto | huggingface | gemini | openai | hashing
# RAG_LLM_PROVIDER=auto
# RAG_EMBEDDINGS_PROVIDER=auto
# RAG_LLM_MODEL=gemini-2.0-flash
