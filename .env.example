# Copy to `.env` and fill in only what you want. Everything is OPTIONAL —
# with no keys set, the assistant runs locally for free.

# --- Cloud LLM backends (optional, best quality) ---
# If set, the "auto" backend uses Anthropic first, then OpenAI.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Override backend selection (optional) ---
# llm provider:        auto | anthropic | openai | huggingface | extractive
# embeddings provider: auto | huggingface | openai | hashing
# RAG_LLM_PROVIDER=auto
# RAG_EMBEDDINGS_PROVIDER=auto
